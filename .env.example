# Copy to .env and fill in. Never commit .env.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# off: call Groq; replay: only recorded answers (eval/cassettes); record: call Groq and save.
LLM_CASSETTES=off
# Evaluation only (provenance eval): free key from https://aistudio.google.com/apikey judges
# answers with gemini-3.5-flash-lite. The app itself never calls Gemini.
GEMINI_API_KEY=

APP_ENV=local
LOG_LEVEL=INFO
DEMO_MODE=true

# Local dev containers (compose.dev.yaml)
DATABASE_URL=postgresql+psycopg://provenance:provenance@127.0.0.1:5432/provenance?connect_timeout=5
QDRANT_URL=http://127.0.0.1:6333

# Signs session-bound file links. Required (>= 32 random chars) when APP_ENV=production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# JSON list of proxy IPs whose X-Forwarded-For is trusted, e.g. ["10.0.0.2"].
TRUSTED_PROXIES=[]
